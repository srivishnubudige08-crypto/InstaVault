# Copy this file to .env and fill in what you need. Everything here is
# optional - without a .env the app boots straight to the sign-in form.
# .env is gitignored; never commit real credentials.

# Pre-fills the sign-in form and restores a cached session on startup.
IG_USERNAME=

# Leave blank. Signing in through the dashboard caches a session instead, so
# the password never has to sit on disk.
IG_PASSWORD=

# --- pacing -----------------------------------------------------------------
# Minimum seconds between outbound Instagram requests. Lower is faster and
# riskier; 2-4 is a sensible range.
REQUEST_DELAY=2.0

# Cooldown observed after Instagram returns a rate-limit response.
RATE_LIMIT_BACKOFF=60

# Attempts per item before it is recorded as failed.
MAX_RETRIES=3

# --- media ------------------------------------------------------------------
# Split a separate .m4a audio track out of each downloaded video.
# Requires ffmpeg on PATH; the sidebar shows whether it was found.
EXTRACT_AUDIO=false

# --- paths ------------------------------------------------------------------
DOWNLOAD_DIR=downloads
SESSION_DIR=session
CACHE_DIR=cache

# --- server -----------------------------------------------------------------
# Localhost only by default. Change deliberately - this app has no auth of its
# own, so anything that can reach the port can drive your Instagram session.
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false

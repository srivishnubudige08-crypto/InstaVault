# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit real credentials.

IG_USERNAME=your_instagram_username

# Optional: leave blank to be prompted interactively at login time (safer).
IG_PASSWORD=

# Where downloaded media is written (relative to project root)
DOWNLOAD_DIR=downloads

# Where the reusable Instaloader session file is cached
SESSION_DIR=session

# Seconds to wait between requests. Keep this conservative to avoid
# rate limiting or account flags.
REQUEST_DELAY=3

# Flask
FLASK_PORT=5000
